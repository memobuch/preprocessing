@prefix bio: <http://purl.org/vocab/bio/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix cidoc: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix memor: <https://www.ns-opfer-graz.at/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix derla: <https://gams.uni-graz.at/> .
@prefix edtf: <http://id.loc.gov/datatypes/edtf/> .

#
# Event modeling of MEMOR
#

# base event of memor
memor:event a owl:Class;
        rdfs:subClassOf cidoc:E5_Event;
        rdfs:label "Event associated with a person"@en, "Ereignis assoziiert mit einer Person"@de.

# place of event
memor:place a owl:Class ;
        rdfs:subClassOf cidoc:E53_Place ;
        # We declare that our historical places are spatial features
        rdfs:subClassOf geo:Feature ;
        rdfs:label "Ort"@de, "Place"@en .

# Event-to-Place link remains strictly CIDOC
memor:took_place_at a owl:ObjectProperty ;
        rdfs:subPropertyOf cidoc:P7_took_place_at ;
        rdfs:domain memor:event ;
        rdfs:range memor:place ;
        rdfs:label "fand statt in"@de, "took place at"@en .

# birth
memor:birth a owl:Class;
        rdfs:subClassOf memor:event;
        rdfs:subClassOf bio:Birth;
        rdfs:subClassOf cidoc:E67_Birth;
        rdfs:label "Birth event of a person"@en,
                "Geburtsereignis einer Person"@de.

# death
memor:death a owl:Class; 
        rdfs:subClassOf memor:event;
        rdfs:subClassOf cidoc:E69_Death;
        rdfs:label "Death event of a person"@en,
                "Todesereignis einer Person"@de.


# voluntary residence as event
memor:voluntary_residence a owl:Class;
        rdfs:subClassOf memor:event;
        rdfs:label "Letzte Freiwillige Wohnadresse"@de.

# forced residence as event
memor:forced_residence a owl:Class;
    rdfs:subClassOf memor:event;
    rdfs:label "Erzwungene Wohnadresse"@de.

# imprisonment
memor:imprisonment a owl:Class;
    rdfs:subClassOf memor:event;
    rdfs:label "Haft"@de.

# flight event
memor:flight a owl:Class;
    rdfs:subClassOf memor:event;
    rdfs:label "Flucht"@de.

# each event has a date
memor:hasDate a owl:DatatypeProperty;
        # CRITICAL: Hook it back into the global LOD graph
        rdfs:subPropertyOf dcterms:date ;
        rdfs:label "has date"@en, "hat Datum"@de;
        rdfs:domain memor:event;
        rdfs:range edtf:EDTF-level1 .

#
# prosecution
#
memor:prosecution a owl:Class;
        rdfs:subClassOf memor:event;
        rdfs:label "Verfolgungsereignis für ein Opfer des Nationalsozialismus."@de.

memor:nsopposition a owl:Class;
        rdfs:subClassOf memor:prosecution;
        rdfs:label "NS-Gegner"@de.

memor:resistance_political a owl:Class;
        rdfs:subClassOf memor:prosecution;
        rdfs:label "Widerstand, politisch"@de.

memor:resistance_religious a owl:Class;
        rdfs:subClassOf memor:prosecution;
        rdfs:label "Widerstand, religiös"@de.

memor:resistance_individual a owl:Class;
        rdfs:subClassOf memor:prosecution;
        rdfs:label "Widerstand, individuell"@de.

memor:resistance_deserters a owl:Class;
        rdfs:subClassOf memor:prosecution;
        rdfs:label "Widerstand, Deserteure"@de.

memor:witnessesjehovah a owl:Class;
        rdfs:subClassOf memor:prosecution;
        rdfs:label "Zeugen Jehovas"@de.

memor:jewishvictims_jewish a owl:Class;
        rdfs:subClassOf memor:prosecution;
        rdfs:label "Jüdische Opfer"@de.

memor:jewishvictims_persecuted-as-jew a owl:Class;
        rdfs:subClassOf memor:prosecution;
        rdfs:label "Jüdische Opfer, als Jude verfolgt"@de.

memor:roma a owl:Class;
        rdfs:subClassOf memor:prosecution;
        rdfs:label "Roma/Romnija und Sinti/Sintize"@de.

memor:euthanasiavictim a owl:Class;
        rdfs:subClassOf memor:prosecution;
        rdfs:label "Opfer der NS-Euthanasie"@de.

memor:homosexualvictim a owl:Class;
        rdfs:subClassOf memor:prosecution;
        rdfs:label "Homosexuelle Opfer"@de.

memor:spainfighter a owl:Class;
        rdfs:subClassOf memor:prosecution;
        rdfs:label "SpanienkämpferInnen"@de.


#
# Person / victim modeling
#
memor:victim a owl:Class ;
         rdfs:subClassOf foaf:Person, schema:Person .

memor:hasEvent a owl:ObjectProperty;
        rdfs:subPropertyOf cidoc:P11i_participated_in ;
        rdfs:domain memor:victim;
        rdfs:range memor:event ;
        rdfs:label "participated in event"@en, "nahm an Ereignis teil"@de .

memor:hasLiteratureReference a owl:DatatypeProperty;
        rdfs:label "has literature source"@en, "hat Literaturreferenz"@de;
        rdfs:domain memor:victim;
        rdfs:range xsd:string.

memor:hasMemorialSign a owl:ObjectProperty;
        rdfs:label "has memorial sign"@en, "hat Erinnerungszeichen"@de;
        rdfs:domain memor:victim;
        rdfs:range derla:placeOfRemembrance.

#
# Archival material
# 

memor:source a owl:Class;
        rdfs:label "Historische Quelle"@de, "historical source"@en.

memor:hasSource a owl:ObjectProperty;
        rdfs:label "has source"@en, "hat Quelle"@de;
        rdfs:comment "Links a person to it's source material"@en; 
        rdfs:domain memor:victim;
        rdfs:range memor:source.

memor:image a owl:Class; 
        rdfs:subClassOf memor:source;
        rdfs:subClassOf schema:ImageObject;
        rdfs:subClassOf foaf:Image;
        rdfs:label "Bildquelle"@de, "image source"@en.


